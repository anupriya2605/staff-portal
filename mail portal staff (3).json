    {
      "parameters": {
        "jsCode": "const webhookItem = $('Webhook').first();\nconst form = webhookItem.json.body;\n\nconst output = [];\n\nfor (const item of $input.all()) {\n\n  const row = item.json;\n\n  const department = (row.Department || \"\").trim().toLowerCase();\n  const year = (row.Year || \"\").trim();\n  const section = (row.Section || \"\").trim().toUpperCase();\n\n  const formDepartment = (form.department || \"\").trim().toLowerCase();\n  const formYear = (form.year || \"\").trim();\n  const formSection = (form.section || \"\").trim().toUpperCase();\n\n  if (\n    department === formDepartment &&\n    year === formYear &&\n    section === formSection\n  ) {\n    output.push({\n      json: row,\n      binary: webhookItem.binary\n    });\n  }\n}\n\n// If no matching rows are found\nif (output.length === 0) {\n  return [\n    {\n      json: {\n        success: false,\n        message: \"No matching students found.\"\n      }\n    }\n  ];\n}\n\nreturn output;"
      },
